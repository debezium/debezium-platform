{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "conductor": {
            "properties": {
                "image": {
                    "type": "string"
                },
                "imagePullPolicy": {
                    "type": "string",
                    "enum": ["IfNotPresent", "Always", "Never"]
                },
                "offset": {
                    "properties": {
                        "existingConfigMap": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "descriptors": {
                    "type": "object",
                    "properties": {
                        "official": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "default": true,
                                    "description": "Enable official Debezium descriptors (downloaded via ORAS at startup)"
                                },
                                "registry": {
                                    "type": "string",
                                    "default": "quay.io",
                                    "description": "Registry hosting the descriptor OCI artifact"
                                },
                                "image": {
                                    "type": "string",
                                    "default": "debezium/debezium-descriptors",
                                    "description": "Image name for the descriptor OCI artifact"
                                },
                                "tag": {
                                    "type": "string",
                                    "default": "nightly",
                                    "description": "Image tag for the descriptor OCI artifact"
                                },
                                "mountPath": {
                                    "type": "string",
                                    "default": "/opt/descriptors",
                                    "description": "Path where descriptors will be downloaded inside the container"
                                }
                            },
                            "required": ["enabled", "registry", "image", "tag", "mountPath"]
                        }
                    }
                },
                "extraVolumes": {
                    "type": "array",
                    "default": []
                },
                "extraVolumeMounts": {
                    "type": "array",
                    "default": []
                },
                "oidc": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false,
                            "description": "Enable OIDC bearer-token security (resource-server / service mode)"
                        },
                        "authServerUrl": {
                            "type": "string",
                            "default": "",
                            "description": "OIDC issuer / realm URL. Required when enabled"
                        },
                        "clientId": {
                            "type": "string",
                            "default": "conductor",
                            "description": "Keycloak client id whose roles are read from resource_access.<clientId>. Must match a client in the realm"
                        },
                        "apiPolicy": {
                            "type": "string",
                            "default": "authenticated",
                            "description": "Policy applied to /api/*: authenticated by default (require a token), permit (opt back out), or a named role policy"
                        },
                        "audience": {
                            "type": "string",
                            "default": "",
                            "description": "Expected aud claim. Empty disables audience enforcement"
                        }
                    }
                }
            },
            "type": "object"
        },
        "database": {
            "properties": {
                "auth": {
                    "properties": {
                        "existingSecret": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "enabled": {
                    "type": "boolean"
                },
                "host": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "debezium-operator": {
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "domain": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "deprecated": true
                },
                "scheme": {
                    "type": "string",
                    "enum": ["", "http", "https"],
                    "default": "",
                    "description": "Scheme for the conductor URL and CORS origin. Empty derives it from ingress TLS"
                }
            },
            "type": "object"
        },
        "env": {
            "type": "array"
        },
        "offset": {
            "properties": {
                "database": {
                    "properties": {
                        "auth": {
                            "properties": {
                                "existingSecret": {
                                    "type": "string"
                                }
                            },
                            "type": "object"
                        },
                        "host": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "password": {
                            "type": "string"
                        },
                        "port": {
                            "type": "integer"
                        },
                        "username": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "reusePlatformDatabase": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "schemaHistory": {
            "properties": {
                "database": {
                    "properties": {
                        "auth": {
                            "properties": {
                                "existingSecret": {
                                    "type": "string"
                                }
                            },
                            "type": "object"
                        },
                        "host": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "password": {
                            "type": "string"
                        },
                        "port": {
                            "type": "integer"
                        },
                        "username": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "reusePlatformDatabase": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "stage": {
            "properties": {
                "image": {
                    "type": "string"
                },
                "imagePullPolicy": {
                    "type": "string",
                    "enum": ["IfNotPresent", "Always", "Never"]
                }
            },
            "type": "object"
        },
        "server": {
            "properties": {
                "image": {
                    "type": "string",
                    "default": "",
                    "description": "Image for Debezium Server instances created by pipelines. If empty, the operator's ServerImageProvider determines the image"
                }
            },
            "type": "object"
        },
        "pipeline": {
            "type": "object",
            "properties": {
                "labels": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {},
                    "description": "Map of labels to apply to DebeziumServer custom resources created by pipelines"
                },
                "health": {
                    "type": "object",
                    "description": "Health probe configuration for Debezium Server pods created by pipelines",
                    "properties": {
                        "liveness": {
                            "type": "object",
                            "description": "Liveness probe settings for Debezium Server pods",
                            "properties": {
                                "initialDelaySeconds": {
                                    "type": "integer",
                                    "default": 30,
                                    "minimum": 0,
                                    "description": "Seconds before the first liveness probe"
                                },
                                "periodSeconds": {
                                    "type": "integer",
                                    "default": 10,
                                    "minimum": 1,
                                    "description": "Interval between liveness probes"
                                },
                                "timeoutSeconds": {
                                    "type": "integer",
                                    "default": 10,
                                    "minimum": 1,
                                    "description": "Timeout for each liveness probe"
                                },
                                "failureThreshold": {
                                    "type": "integer",
                                    "default": 3,
                                    "minimum": 1,
                                    "description": "Consecutive failures before the container is restarted"
                                }
                            }
                        },
                        "readiness": {
                            "type": "object",
                            "description": "Readiness probe settings for Debezium Server pods",
                            "properties": {
                                "initialDelaySeconds": {
                                    "type": "integer",
                                    "default": 10,
                                    "minimum": 0,
                                    "description": "Seconds before the first readiness probe"
                                },
                                "periodSeconds": {
                                    "type": "integer",
                                    "default": 10,
                                    "minimum": 1,
                                    "description": "Interval between readiness probes"
                                },
                                "timeoutSeconds": {
                                    "type": "integer",
                                    "default": 10,
                                    "minimum": 1,
                                    "description": "Timeout for each readiness probe"
                                },
                                "failureThreshold": {
                                    "type": "integer",
                                    "default": 3,
                                    "minimum": 1,
                                    "description": "Consecutive failures before the container is marked unready"
                                }
                            }
                        }
                    }
                }
            }
        },
        "monitoring": {
            "type": "object",
            "description": "Monitoring configuration for OpenTelemetry and Prometheus",
            "properties": {
                "otel": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false,
                            "description": "Enable OpenTelemetry monitoring infrastructure"
                        },
                        "collector": {
                            "type": "object",
                            "properties": {
                                "image": {
                                    "type": "string",
                                    "default": "",
                                    "description": "Override OTel Collector image. If empty, the operator's default is used. Must include the Prometheus exporter (available in the base otelcol and contrib distributions, but not in otelcol-k8s)"
                                },
                                "replicas": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "default": 1,
                                    "description": "Number of OTel Collector replicas"
                                },
                                "receivers": {
                                    "type": "object",
                                    "properties": {
                                        "grpc": {
                                            "type": "object",
                                            "properties": {
                                                "port": {
                                                    "type": "integer",
                                                    "default": 4317
                                                }
                                            }
                                        },
                                        "http": {
                                            "type": "object",
                                            "properties": {
                                                "port": {
                                                    "type": "integer",
                                                    "default": 4318
                                                }
                                            }
                                        }
                                    }
                                },
                                "processors": {
                                    "type": "object",
                                    "properties": {
                                        "batch": {
                                            "type": "object",
                                            "properties": {
                                                "timeout": {
                                                    "type": "string",
                                                    "default": "5s"
                                                },
                                                "sendBatchSize": {
                                                    "type": "integer",
                                                    "default": 512
                                                }
                                            }
                                        }
                                    }
                                },
                                "exporters": {
                                    "type": "object",
                                    "properties": {
                                        "prometheus": {
                                            "type": "object",
                                            "properties": {
                                                "port": {
                                                    "type": "integer",
                                                    "default": 8889
                                                },
                                                "resourceToTelemetryConversion": {
                                                    "type": "boolean",
                                                    "default": true
                                                },
                                                "constLabels": {
                                                    "type": "object",
                                                    "additionalProperties": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "panels": {
                    "type": "object",
                    "properties": {
                        "additionalPanelsPath": {
                            "type": "string",
                            "default": "",
                            "description": "Path to a YAML file with additional monitoring panels. Panels defined here are merged with the built-in panels; panels with matching IDs override the built-in defaults."
                        },
                        "refreshInterval": {
                            "type": "string",
                            "default": "30s",
                            "description": "How often the conductor reloads panels from the additional panels file. Accepts duration strings (e.g. 1s, 30s, 5m)."
                        }
                    }
                },
                "prometheus": {
                    "type": "object",
                    "properties": {
                        "external": {
                            "type": "object",
                            "properties": {
                                "url": {
                                    "type": "string",
                                    "default": "",
                                    "description": "URL of an external Prometheus instance (for users not using Prometheus Operator)"
                                }
                            }
                        },
                        "serviceMonitor": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "default": true,
                                    "description": "Create a ServiceMonitor for the OTel Collector"
                                },
                                "scrapeInterval": {
                                    "type": "string",
                                    "default": "15s"
                                },
                                "labels": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "description": "Labels for Prometheus Operator discovery"
                                }
                            }
                        }
                    }
                }
            }
        },
        "alerting": {
            "type": "object",
            "description": "Alerting configuration for evaluation engine, notifications, and email",
            "properties": {
                "evaluation": {
                    "type": "object",
                    "properties": {
                        "interval": {
                            "type": "string",
                            "default": "60s",
                            "description": "How often the alert evaluation engine runs. Accepts duration strings (e.g. 30s, 60s, 5m)"
                        }
                    }
                },
                "history": {
                    "type": "object",
                    "properties": {
                        "retention": {
                            "type": "string",
                            "default": "30d",
                            "description": "How long resolved alert events are kept before cleanup"
                        },
                        "cleanup": {
                            "type": "object",
                            "properties": {
                                "interval": {
                                    "type": "string",
                                    "default": "24h",
                                    "description": "How often the history cleanup job runs"
                                }
                            }
                        }
                    }
                },
                "webhook": {
                    "type": "object",
                    "properties": {
                        "allowPrivateNetworks": {
                            "type": "boolean",
                            "default": false,
                            "description": "Allow webhook URLs to resolve to private, loopback, or link-local IP addresses. When false (default), SSRF protection blocks requests to non-public addresses"
                        },
                        "maxAttempts": {
                            "type": "integer",
                            "default": 3,
                            "description": "Maximum number of delivery attempts for webhook notifications"
                        },
                        "connectTimeout": {
                            "type": "string",
                            "default": "5S",
                            "description": "Connection timeout for webhook HTTP calls (ISO 8601 duration)"
                        },
                        "readTimeout": {
                            "type": "string",
                            "default": "10S",
                            "description": "Read timeout for webhook HTTP calls (ISO 8601 duration)"
                        }
                    }
                },
                "email": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string",
                            "default": "",
                            "description": "SMTP server hostname"
                        },
                        "port": {
                            "type": "integer",
                            "default": 587,
                            "description": "SMTP server port"
                        },
                        "from": {
                            "type": "string",
                            "default": "",
                            "description": "Sender email address for alert notifications"
                        },
                        "startTls": {
                            "type": "string",
                            "default": "REQUIRED",
                            "description": "STARTTLS mode (DISABLED, OPTIONAL, REQUIRED)"
                        },
                        "auth": {
                            "type": "object",
                            "properties": {
                                "existingSecret": {
                                    "type": "string",
                                    "default": "",
                                    "description": "Name of an existing K8s Secret containing 'username' and 'password' keys for SMTP authentication"
                                }
                            }
                        }
                    }
                }
            }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "className": {
              "type": "string",
              "default": ""
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "secretName": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": ["enabled"]
            }
          },
          "required": ["enabled", "tls"]
        }
    },
    "type": "object"
}
