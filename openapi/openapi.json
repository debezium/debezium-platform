    "/api/monitoring/panels/{id}/query" : {
      "get" : {
        "summary" : "Query monitoring panel data for a specific pipeline",
        "tags" : [ "Monitoring" ],
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "End time (ISO 8601)",
          "required" : true,
          "name" : "end",
          "in" : "query",
          "schema" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }, {
          "description" : "Pipeline identifier",
          "required" : true,
          "name" : "pipeline_id",
          "in" : "query",
          "schema" : {
            "type" : "string",
            "pattern" : "[a-zA-Z0-9_-]+"
          }
        }, {
          "description" : "Start time (ISO 8601)",
          "required" : true,
          "name" : "start",
          "in" : "query",
          "schema" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }, {
          "description" : "Query resolution step (e.g. 15s, 1m)",
          "name" : "step",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PanelQueryResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid parameters",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object"
